---
import BaseLayout from '../layouts/BaseLayout.astro';
import { topics } from '../lib/taxonomy';
import { contentTypeLabel } from '../lib/format';
import { getNews } from '../lib/news';
import { collectHashtags } from '../lib/hashtags';
import { toUrl } from '../lib/paths';

const hashtags = collectHashtags(await getNews());
---

<BaseLayout title="検索" description="キーワード、ジャンル、日付、朝刊・夕刊から記事を探せます。">
  <header class="page-heading">
    <p class="eyebrow">記事を探す</p>
    <h1>記事を探す</h1>
    <p class="intro">キーワードや日付を組み合わせて、読みたい記事を絞り込みます。</p>
  </header>
  <nav class="search-quick" aria-label="クイック検索">
    <button type="button" data-quick-search="recent" aria-pressed="false">最近7日</button><button type="button" data-quick-search="essay" aria-pressed="false">エッセイ</button><button type="button" data-quick-search="short-short" aria-pressed="false">ショートショート</button><button type="button" data-quick-search="international" aria-pressed="false">国際</button><button type="button" data-quick-search="economy" aria-pressed="false">経済</button><button type="button" data-quick-search="science" aria-pressed="false">科学</button>
  </nav>
  <form class="search-form" data-search-form>
    <div class="form-field">
      <label for="keyword">キーワード</label>
      <input id="keyword" name="keyword" type="search" placeholder="例：選挙、宇宙、ことば" autocomplete="off" />
    </div>
    <details class="search-details">
      <summary>条件を絞り込む <span>ジャンル・日付・読み物・朝刊／夕刊</span></summary>
      <div class="search-details__body">
        <div class="form-field">
          <label for="tag">登録キーワード <small>記事に付けられた言葉から選びます</small></label>
          <select id="tag" name="tag"><option value="">すべての登録キーワード</option>{hashtags.map((tag) => <option value={tag.slug}>#{tag.label}</option>)}</select>
        </div>
        <div class="form-field"><label for="topic">ジャンル</label><select id="topic" name="topic"><option value="">すべてのジャンル</option>{topics.map((topic) => <option value={topic.slug}>{topic.name}</option>)}</select></div>
        <div class="form-field"><label for="content-type">読み物の種類</label><select id="content-type" name="contentType"><option value="">すべての種類</option>{Object.entries(contentTypeLabel).map(([key, label]) => <option value={key}>{label}</option>)}</select></div>
        <div class="form-field"><fieldset><legend>朝刊・夕刊</legend><label><input type="radio" name="edition" value="" checked /> すべて</label><label><input type="radio" name="edition" value="morning" /> 朝刊</label><label><input type="radio" name="edition" value="evening" /> 夕刊</label></fieldset></div>
        <div class="search-date-fields"><div class="form-field"><label for="start">開始日</label><input id="start" name="start" type="date" /></div><div class="form-field"><label for="end">終了日</label><input id="end" name="end" type="date" /></div></div>
      </div>
    </details>
    <div class="form-actions">
      <button type="submit">検索する</button>
      <button class="clear-button" type="button" data-search-clear>すべてクリア</button>
    </div>
  </form>
  <p class="search-status" data-search-status aria-live="polite">記事を読み込んでいます。</p>
  <div class="article-list" data-search-results></div>
  <noscript><p class="empty-state">検索にはJavaScriptを使用します。ジャンル一覧やアーカイブから記事を読むこともできます。</p></noscript>
</BaseLayout>

<script define:vars={{ indexUrl: toUrl('search-index.json'), baseUrl: toUrl() }}>
  const form = document.querySelector('[data-search-form]');
  const results = document.querySelector('[data-search-results]');
  const status = document.querySelector('[data-search-status]');
  const clearButton = document.querySelector('[data-search-clear]');
  const typeLabels = { essay: 'エッセイ', 'short-short': 'ショートショート', 'flash-fiction': '掌編', dialogue: '会話篇', observation: '観察記' };
  const editionLabels = { morning: '朝刊', evening: '夕刊' };
  let items = [];
  let activeQuick = '';

  function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[character]));
  }
  function displayDate(day) {
    const [year, month, date] = day.split('-');
    return `${year}年${Number(month)}月${Number(date)}日`;
  }
  function getTokyoDateParts(date = new Date()) {
    const parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Tokyo', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(date);
    return Object.fromEntries(parts.map((part) => [part.type, part.value]));
  }
  function tokyoDayOffset(offset = 0) {
    const today = getTokyoDateParts();
    const value = new Date(Date.UTC(Number(today.year), Number(today.month) - 1, Number(today.day)));
    value.setUTCDate(value.getUTCDate() + offset);
    return `${value.getUTCFullYear()}-${String(value.getUTCMonth() + 1).padStart(2, '0')}-${String(value.getUTCDate()).padStart(2, '0')}`;
  }
  function setQuick(value = '') {
    activeQuick = value;
    document.querySelectorAll('[data-quick-search]').forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.quickSearch === value)));
  }
  function detectQuick() {
    const values = new FormData(form);
    const quick = String(values.get('contentType') || values.get('topic') || '');
    if (['essay', 'short-short', 'international', 'economy', 'science'].includes(quick)) return quick;
    if (String(values.get('start') || '') === tokyoDayOffset(-6) && String(values.get('end') || '') === tokyoDayOffset()) return 'recent';
    return '';
  }
  function render(found) {
    status.textContent = `${found.length}件の記事が見つかりました。新しい順に表示しています。`;
    if (!found.length) {
      results.innerHTML = '<p class="empty-state">条件に合う記事はありませんでした。<br />条件を少し減らしてみてください。</p>';
      return;
    }
    results.innerHTML = found.map((item) => `<article class="article-card"><h2><a href="${item.url}">${escapeHtml(item.title)}</a></h2><div class="article-card__meta"><time datetime="${item.date}">${displayDate(item.date)}</time><span class="edition-badge ${item.edition}"><span>${item.edition === 'morning' ? '朝' : '夕'}</span>${editionLabels[item.edition]}</span><span>約${item.readingTime}分</span></div><p>${escapeHtml(item.description)}</p><div class="article-card__footer"><div class="tag-list">${item.topics.map((topic, index) => `<a href="${baseUrl}search/?topic=${encodeURIComponent(item.topicSlugs[index])}" aria-label="${escapeHtml(topic)}で記事を探す">${escapeHtml(topic)}</a>`).join('')}</div><span class="content-type">${item.contentTypes.map((type) => typeLabels[type]).join('・')}</span></div><a class="text-link article-card__read" href="${item.url}">読む →</a></article>`).join('');
  }
  function applyQuery() {
    const query = new URLSearchParams(window.location.search);
    ['keyword', 'tag', 'topic', 'contentType', 'start', 'end'].forEach((name) => {
      const control = form.elements.namedItem(name);
      if (control && query.has(name)) control.value = query.get(name);
    });
    const edition = query.get('edition');
    if (edition) {
      const radio = form.querySelector(`input[name="edition"][value="${edition}"]`);
      if (radio) radio.checked = true;
    }
    setQuick(detectQuick());
  }
  function syncQuery() {
    const query = new URLSearchParams();
    const values = new FormData(form);
    ['keyword', 'tag', 'topic', 'contentType', 'edition', 'start', 'end'].forEach((name) => {
      const value = String(values.get(name) || '');
      if (value) query.set(name, value);
    });
    const suffix = query.toString();
    window.history.replaceState({}, '', `${window.location.pathname}${suffix ? `?${suffix}` : ''}`);
  }
  function search() {
    const values = new FormData(form);
    const keyword = String(values.get('keyword') || '').trim().toLocaleLowerCase('ja-JP');
    const tag = String(values.get('tag') || '');
    const topic = String(values.get('topic') || '');
    const contentType = String(values.get('contentType') || '');
    const edition = String(values.get('edition') || '');
    const start = String(values.get('start') || '');
    const end = String(values.get('end') || '');
    const found = items.filter((item) => {
      const searchable = [item.title, item.description, ...item.topics, ...item.readingTitles, ...item.hashtags.map((hashtag) => hashtag.label), ...item.keywords].join(' ').toLocaleLowerCase('ja-JP');
      return (!keyword || searchable.includes(keyword))
        && (!tag || item.hashtags.some((hashtag) => hashtag.slug === tag))
        && (!topic || item.topicSlugs.includes(topic))
        && (!contentType || item.contentTypes.includes(contentType))
        && (!edition || item.edition === edition)
        && (!start || item.date >= start)
        && (!end || item.date <= end);
    });
    render(found);
  }
  form.addEventListener('submit', (event) => { event.preventDefault(); setQuick(detectQuick()); syncQuery(); search(); });
  form.addEventListener('change', () => { if (activeQuick && detectQuick() !== activeQuick) setQuick(); });
  clearButton.addEventListener('click', () => { form.reset(); setQuick(); syncQuery(); search(); });
  document.querySelectorAll('[data-quick-search]').forEach((button) => button.addEventListener('click', () => {
    form.reset();
    const quick = button.dataset.quickSearch;
    if (quick === 'recent') {
      form.elements.start.value = tokyoDayOffset(-6); form.elements.end.value = tokyoDayOffset();
    } else if (['essay', 'short-short'].includes(quick)) form.elements.contentType.value = quick;
    else form.elements.topic.value = quick;
    setQuick(quick); syncQuery(); search();
  }));
  fetch(indexUrl)
    .then((response) => response.ok ? response.json() : Promise.reject(new Error('検索データを取得できませんでした。')))
    .then((data) => { items = data; applyQuery(); search(); })
    .catch(() => { status.textContent = '検索データを読み込めませんでした。ページを再読み込みしてください。'; });
</script>
