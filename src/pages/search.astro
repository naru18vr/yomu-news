---
import BaseLayout from '../layouts/BaseLayout.astro';
import { topics } from '../lib/taxonomy';
import { contentTypeLabel } from '../lib/format';
import { toUrl } from '../lib/paths';
---

<BaseLayout title="検索" description="キーワード、ジャンル、日付、朝刊・夕刊から記事を探せます。">
  <header class="page-heading">
    <p class="eyebrow">SEARCH</p>
    <h1>記事を探す</h1>
    <p class="intro">キーワードや日付を組み合わせて、読みたい記事を絞り込みます。</p>
  </header>
  <form class="search-form" data-search-form>
    <div class="form-field">
      <label for="keyword">キーワード</label>
      <input id="keyword" name="keyword" type="search" placeholder="例：選挙、宇宙、ことば" autocomplete="off" />
    </div>
    <div class="form-field">
      <label for="topic">ジャンル</label>
      <select id="topic" name="topic"><option value="">すべてのジャンル</option>{topics.map((topic) => <option value={topic.slug}>{topic.name}</option>)}</select>
    </div>
    <div class="form-field">
      <label for="content-type">読み物の種類</label>
      <select id="content-type" name="contentType"><option value="">すべての種類</option>{Object.entries(contentTypeLabel).map(([key, label]) => <option value={key}>{label}</option>)}</select>
    </div>
    <div class="form-field">
      <fieldset>
        <legend>朝刊・夕刊</legend>
        <label><input type="radio" name="edition" value="" checked /> すべて</label>
        <label><input type="radio" name="edition" value="morning" /> 朝刊</label>
        <label><input type="radio" name="edition" value="evening" /> 夕刊</label>
      </fieldset>
    </div>
    <div class="form-field">
      <label for="start">開始日</label>
      <input id="start" name="start" type="date" />
    </div>
    <div class="form-field">
      <label for="end">終了日</label>
      <input id="end" name="end" type="date" />
    </div>
    <div class="form-actions">
      <button type="submit">検索する</button>
      <button class="clear-button" type="button" data-search-clear>すべてクリア</button>
    </div>
  </form>
  <p class="search-status" data-search-status aria-live="polite">記事を読み込んでいます。</p>
  <div class="article-list" data-search-results></div>
  <noscript><p class="empty-state">検索にはJavaScriptを使用します。ジャンル一覧やアーカイブから記事を読むこともできます。</p></noscript>
</BaseLayout>

<script define:vars={{ indexUrl: toUrl('search-index.json') }}>
  const form = document.querySelector('[data-search-form]');
  const results = document.querySelector('[data-search-results]');
  const status = document.querySelector('[data-search-status]');
  const clearButton = document.querySelector('[data-search-clear]');
  const typeLabels = { essay: 'エッセイ', 'short-short': 'ショートショート', 'flash-fiction': '掌編', dialogue: '会話篇', observation: '観察記' };
  const editionLabels = { morning: '朝刊', evening: '夕刊' };
  let items = [];

  function escapeHtml(value) {
    return String(value).replace(/[&<>"']/g, (character) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[character]));
  }
  function displayDate(day) {
    const [year, month, date] = day.split('-');
    return `${year}年${Number(month)}月${Number(date)}日`;
  }
  function render(found) {
    status.textContent = `${found.length}件の記事が見つかりました。新しい順に表示しています。`;
    if (!found.length) {
      results.innerHTML = '<p class="empty-state">条件に合う記事はありません。条件を変えるか、「すべてクリア」を試してください。</p>';
      return;
    }
    results.innerHTML = found.map((item) => `<article class="article-card"><div class="article-card__meta"><time datetime="${item.date}">${displayDate(item.date)}</time><span class="edition-badge ${item.edition}"><span>${item.edition === 'morning' ? '朝' : '夕'}</span>${editionLabels[item.edition]}</span><span>${item.readingTime}分で読める</span></div><h2><a href="${item.url}">${escapeHtml(item.title)}</a></h2><p>${escapeHtml(item.description)}</p><div class="article-card__footer"><div class="tag-list">${item.topics.map((topic) => `<span>${escapeHtml(topic)}</span>`).join('')}</div><span class="content-type">${item.contentTypes.map((type) => typeLabels[type]).join('・')}</span></div><a class="text-link article-card__read" href="${item.url}">読む →</a></article>`).join('');
  }
  function search() {
    const values = new FormData(form);
    const keyword = String(values.get('keyword') || '').trim().toLocaleLowerCase('ja-JP');
    const topic = String(values.get('topic') || '');
    const contentType = String(values.get('contentType') || '');
    const edition = String(values.get('edition') || '');
    const start = String(values.get('start') || '');
    const end = String(values.get('end') || '');
    const found = items.filter((item) => {
      const searchable = [item.title, item.description, ...item.topics, ...item.readingTitles, ...item.keywords].join(' ').toLocaleLowerCase('ja-JP');
      return (!keyword || searchable.includes(keyword))
        && (!topic || item.topicSlugs.includes(topic))
        && (!contentType || item.contentTypes.includes(contentType))
        && (!edition || item.edition === edition)
        && (!start || item.date >= start)
        && (!end || item.date <= end);
    });
    render(found);
  }
  form.addEventListener('submit', (event) => { event.preventDefault(); search(); });
  clearButton.addEventListener('click', () => { form.reset(); search(); });
  fetch(indexUrl)
    .then((response) => response.ok ? response.json() : Promise.reject(new Error('検索データを取得できませんでした。')))
    .then((data) => { items = data; search(); })
    .catch(() => { status.textContent = '検索データを読み込めませんでした。ページを再読み込みしてください。'; });
</script>
