---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getNews } from '../../lib/news';
import { collectHashtags } from '../../lib/hashtags';
import { toUrl } from '../../lib/paths';

const hashtags = collectHashtags(await getNews());
---

<BaseLayout title="キーワード" description="ニュースに登場した言葉から記事を探せます。">
  <header class="page-heading">
    <p class="eyebrow">キーワード</p>
    <h1>キーワードから読む</h1>
    <p class="intro">ニュースに登場した言葉から記事を探せます。</p>
  </header>
  <div class="hashtag-cloud" aria-label="キーワード一覧">
    {hashtags.map((tag) => <a href={toUrl(`tags/${tag.slug}/`)}>#{tag.label}<span>{tag.count}</span></a>)}
  </div>
  <p class="page-action"><a class="button button--secondary" href={toUrl('search/')}>条件を組み合わせて検索する</a></p>
</BaseLayout>
