---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getNews, articlesOnDay } from '../../lib/news';
import { formatDay } from '../../lib/format';
import { toUrl } from '../../lib/paths';

export const getStaticPaths = (async () => {
  const articles = await getNews();
  return [...new Set(articles.map((article) => article.data.day))].map((day) => ({ params: { day } }));
}) satisfies GetStaticPaths;

const { day } = Astro.params;
const articles = articlesOnDay(await getNews(), day ?? '');
---

<BaseLayout title={`${formatDay(day ?? '')}の記事`} description={`${formatDay(day ?? '')}に公開した朝刊・夕刊です。`}>
  <header class="page-heading">
    <p class="eyebrow">DAY ARCHIVE</p>
    <h1>{formatDay(day ?? '')}</h1>
    <p class="intro">この日に公開された記事です。朝刊、夕刊の順に読めます。</p>
  </header>
  <div class="article-list">
    {articles.map((article) => <ArticleCard article={article} />)}
  </div>
  <p><a class="button button--secondary" href={toUrl('calendar/')}>カレンダーへ戻る</a></p>
</BaseLayout>
