---
import BaseLayout from '../layouts/BaseLayout.astro';
import EditionBadge from '../components/EditionBadge.astro';
import { getNews, articlesOnDay } from '../lib/news';
import { formatDay, formatMonth } from '../lib/format';
import { toUrl } from '../lib/paths';

const articles = await getNews();
const months = [...new Set(articles.map((article) => article.data.day.slice(0, 7)))].sort().reverse();
---

<BaseLayout title="アーカイブ" description="年月別に読むニュースの記事を一覧で表示します。">
  <header class="page-heading">
    <p class="eyebrow">ARCHIVE</p>
    <h1>過去の記事</h1>
    <p class="intro">年月ごとに、朝刊と夕刊を分けて表示しています。</p>
  </header>
  <div class="archive-list">
    {months.map((month) => {
      const days = [...new Set(articles.filter((article) => article.data.day.startsWith(month)).map((article) => article.data.day))].sort().reverse();
      return <section class="archive-month">
        <h2>{formatMonth(month)}</h2>
        {days.map((day) => <div class="archive-day">
          <p>{formatDay(day).replace(/^\d{4}年/, '')}</p>
          <div class="archive-day__links">
            {articlesOnDay(articles, day).map((article) => <a href={toUrl(`articles/${article.slug}/`)}><EditionBadge edition={article.data.edition} />{article.data.title}</a>)}
          </div>
        </div>)}
      </section>;
    })}
  </div>
</BaseLayout>
