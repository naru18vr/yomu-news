---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MonthlyCard from '../../components/MonthlyCard.astro';
import { getLatestMonthlyIssue, getPublishedMonthlyIssues } from '../../lib/monthly';
import { toUrl } from '../../lib/paths';
const issues = await getPublishedMonthlyIssues(); const latest = await getLatestMonthlyIssue();
const years = [...new Set(issues.map((issue) => issue.data.year))].sort((a, b) => b - a);
---
<BaseLayout title="月間まとめ" description="1か月のニュースを、総括とエッセイと物語で振り返ります。">
  <header class="page-heading"><p class="eyebrow">月刊</p><h1>月間まとめ</h1><p>1か月のニュースを、総括とエッセイと物語で振り返ります。</p></header>
  {latest ? <section class="monthly-latest"><p class="eyebrow">最新号</p><MonthlyCard issue={latest} featured /></section> : <section class="empty-latest"><h2>月刊号は現在準備中です</h2><p>公開まで、毎日の朝刊・夕刊をお楽しみください。</p><a class="button" href={toUrl()}>今日の記事へ戻る</a></section>}
  {years.map((year) => {
    const yearIssues = issues.filter((issue) => issue.data.year === year);
    const earlierIssues = yearIssues.filter((issue) => issue.slug !== latest?.slug);
    return <section class="monthly-year-list"><div class="section-heading"><div><p class="eyebrow">{year}年</p><h2>{year}年の月刊号</h2></div><a class="text-link" href={toUrl(`monthly/${year}/`)}>年別一覧 →</a></div>{earlierIssues.length > 0 ? <div class="article-list">{earlierIssues.map((issue) => <MonthlyCard issue={issue} />)}</div> : <p class="monthly-year-list__empty">この年の月刊号は最新号のみです。</p>}</section>
  })}
</BaseLayout>
