---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { getPublishedMonthlyIssues } from '../../lib/monthly'; import { getCollection } from 'astro:content'; import { toUrl } from '../../lib/paths';
export async function getStaticPaths() { return (await getPublishedMonthlyIssues()).map((issue) => ({ params: { period: issue.slug }, props: { issue } })); }
const { issue } = Astro.props; const parts = (await getCollection('monthlyParts')).filter((part) => part.data.period === issue.data.period).sort((a,b) => a.data.order-b.data.order);
---
<BaseLayout title={`${issue.data.title}の目次`} description={issue.data.description}><header class="page-heading"><p class="eyebrow">月刊・4本の読み物</p><h1>{issue.data.title}</h1><p>{issue.data.description}</p></header><div class="article-list">{parts.map((part) => <article class="monthly-card"><p class="eyebrow">第{part.data.order}回・約{part.data.readingTime}分</p><h2><a href={toUrl(`monthly/${issue.slug}/${part.slug}/`)}>{part.data.title}</a></h2><p>{part.data.description}</p><a class="text-link" href={toUrl(`monthly/${issue.slug}/${part.slug}/`)}>読む →</a></article>)}</div></BaseLayout>
