---
import BaseLayout from '../../layouts/BaseLayout.astro'; import { getPublishedMonthlyIssues } from '../../lib/monthly'; import { getCollection } from 'astro:content'; import { toUrl } from '../../lib/paths';
export async function getStaticPaths() { return (await getPublishedMonthlyIssues()).map((issue) => ({ params: { period: issue.slug }, props: { issue } })); }
const { issue } = Astro.props; const parts = (await getCollection('monthlyParts')).filter((part) => part.data.period === issue.data.period).sort((a,b) => a.data.order-b.data.order);
---
<BaseLayout title={`${issue.data.displayTitle ?? issue.data.title}｜${issue.data.title}`} description={issue.data.description}><header class="page-heading monthly-issue-heading"><p class="eyebrow">{issue.data.title}</p><h1>{issue.data.displayTitle ?? issue.data.title}</h1><p>{issue.data.description}</p>{(issue.data.essayTitle || issue.data.shortStoryTitle) && <dl class="monthly-contents"><dt>収録</dt>{issue.data.essayTitle && <dd>エッセイ「{issue.data.essayTitle}」</dd>}{issue.data.shortStoryTitle && <dd>ショートショート「{issue.data.shortStoryTitle}」</dd>}</dl>}</header><div class="article-list">{parts.map((part) => <article class="monthly-card"><p class="eyebrow">第{part.data.order}回・約{part.data.readingTime}分</p><h2>{part.data.title}</h2><p>{part.data.description}</p><a class="text-link" href={toUrl(`monthly/${issue.slug}/${part.data.partSlug}/`)}>読む →</a></article>)}</div></BaseLayout>
