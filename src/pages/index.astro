---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import EditionBadge from '../components/EditionBadge.astro';
import { getNews } from '../lib/news';
import { getWorks } from '../lib/works';
import { articleDisplayTitle, formatDay } from '../lib/format';
import { tokyoDay } from '../lib/dates';
import { toUrl } from '../lib/paths';
import { getLatestMonthlyIssue } from '../lib/monthly';

const articles = await getNews();
const works = await getWorks();
const latestMorning = articles.find((article) => article.data.edition === 'morning');
const today = tokyoDay();
const isTodayMorning = latestMorning?.data.day === today;
const primaryLabel = isTodayMorning ? '今日の記事' : '最新の記事';
const primaryButtonLabel = isTodayMorning ? '今日の朝刊を読む' : '最新の朝刊を読む';
const todayEvening = isTodayMorning
  ? articles.find((article) => article.data.day === today && article.data.edition === 'evening')
  : undefined;
const morningWorks = latestMorning
  ? works.filter((work) => work.data.articleSlug === latestMorning.slug).sort((a, b) => (a.data.type === 'essay' ? -1 : 1) - (b.data.type === 'essay' ? -1 : 1))
  : [];
const todayEssay = morningWorks.find((work) => work.data.type === 'essay');
const todayShortShort = morningWorks.find((work) => work.data.type === 'short-short');
const recent = articles.filter((article) => article.slug !== latestMorning?.slug && article.slug !== todayEvening?.slug).slice(0, 4);
const latestMonthly = await getLatestMonthlyIssue();
---

<BaseLayout>
  <section class="home-hero">
    <p class="eyebrow">今日、読むもの</p>
    <h1 class="lede">今日の重大ニュースを、<br />エッセイと物語で読む。</h1>
    <p class="intro">今日のニュースを、短い解説とエッセイや物語で読むサイトです。</p>
  </section>

  {latestMorning && <section class="today-main" aria-label={primaryLabel}>
    <p class="eyebrow">{primaryLabel}</p>
    {morningWorks.length > 0 ? <div class="today-work-grid">
      {todayEssay && <article class="today-work-card today-work-card--essay">
        <div class="article-card__meta"><time datetime={latestMorning.data.day}>{formatDay(latestMorning.data.day)}</time><EditionBadge edition="morning" /><span>約{todayEssay.data.readingTime}分</span></div>
        <p class="today-work-card__label">今日の読み物</p>
        <h2><a href={toUrl(`works/${todayEssay.slug}/`)}>{todayEssay.data.title}</a></h2>
        <p>{todayEssay.data.description}</p>
        <a class="button" href={toUrl(`works/${todayEssay.slug}/`)}>今日の読み物を読む</a>
      </article>}
      {todayShortShort && <article class="today-work-card today-work-card--short-short">
        <div class="article-card__meta"><time datetime={latestMorning.data.day}>{formatDay(latestMorning.data.day)}</time><EditionBadge edition="morning" /><span>約{todayShortShort.data.readingTime}分</span></div>
        <p class="today-work-card__label">ショートショート</p>
        <h2><a href={toUrl(`works/${todayShortShort.slug}/`)}>{todayShortShort.data.title}</a></h2>
        <p>{todayShortShort.data.description}</p>
        <a class="button" href={toUrl(`works/${todayShortShort.slug}/`)}>ショートショートを読む</a>
      </article>}
    </div> : <article class="today-main__card">
      <div class="article-card__meta"><time datetime={latestMorning.data.day}>{formatDay(latestMorning.data.day)}</time><EditionBadge edition="morning" /><span>約{latestMorning.data.readingTime}分</span></div>
      <h2><a href={toUrl(`articles/${latestMorning.slug}/`)}>{articleDisplayTitle(latestMorning.data)}</a></h2>
      <p>{latestMorning.data.description}</p>
      <a class="button today-main__button" href={toUrl(`articles/${latestMorning.slug}/`)}>{primaryButtonLabel}</a>
    </article>}
  </section>}

  {todayEvening && <section class="today-evening" aria-labelledby="today-evening-heading">
    <div class="section-heading"><div><p class="eyebrow">今日の続報</p><h2 id="today-evening-heading">今日の夕刊</h2></div></div>
    <article class="today-evening__card">
      <div class="article-card__meta"><EditionBadge edition="evening" /><span>約{todayEvening.data.readingTime}分</span></div>
      <h3><a href={toUrl(`articles/${todayEvening.slug}/`)}>{articleDisplayTitle(todayEvening.data)}</a></h3>
      <p>{todayEvening.data.description}</p>
      <a class="text-link" href={toUrl(`articles/${todayEvening.slug}/`)}>夕刊を読む →</a>
    </article>
  </section>}

  {!latestMorning && <section class="empty-latest" aria-labelledby="empty-latest-heading">
    <p class="eyebrow">新しい記事を準備中です</p>
    <h2 id="empty-latest-heading">朝刊を準備しています</h2>
    <p>新しい記事が公開されるまで、過去の記事をお楽しみください。</p>
    <div><a class="button" href={toUrl('archive/')}>最近の記事を見る</a><a class="button button--secondary" href={toUrl('calendar/')}>カレンダーから探す</a></div>
  </section>}

  <nav class="quick-links" aria-label="読み物を探す">
    <a class="quick-link" href={toUrl('calendar/')}><strong>カレンダーから読む</strong><span>日付を選んで朝刊・夕刊へ</span></a>
    <a class="quick-link" href={toUrl('search/')}><strong>記事を探す</strong><span>ジャンル・キーワード・日付から</span></a>
    {latestMonthly && <a class="quick-link quick-link--monthly" href={toUrl('monthly/')}><strong>月間まとめを読む</strong><span>{latestMonthly.data.year}年{latestMonthly.data.month}月号から、これまでの月刊号まで</span></a>}
  </nav>

  {latestMorning && <p class="edition-shortcut"><a href={toUrl(`articles/${latestMorning.slug}/`)}>朝刊を最初から読む →</a></p>}

  <section aria-labelledby="recent-heading">
    <div class="section-heading">
      <div><p class="eyebrow">これまでの記事</p><h2 id="recent-heading">最近の記事</h2></div>
      <a class="text-link" href={toUrl('archive/')}>すべて見る →</a>
    </div>
    <div class="article-list">{recent.map((article) => <ArticleCard article={article} compact />)}</div>
  </section>
</BaseLayout>
