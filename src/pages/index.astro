---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Calendar from '../components/Calendar.astro';
import { getNews } from '../lib/news';
import { getWorks } from '../lib/works';
import { contentTypeLabel, formatDay } from '../lib/format';
import { toUrl } from '../lib/paths';

const articles = await getNews();
const works = await getWorks();
const latestMorning = articles.find((article) => article.data.edition === 'morning');
const latestEvening = articles.find((article) => article.data.edition === 'evening');
const today = articles[0]?.data.day;
const todayWorks = works.filter((work) => work.data.day === today);
const todayEssay = todayWorks.find((work) => work.data.type === 'essay');
const todayShortShort = todayWorks.find((work) => work.data.type === 'short-short');
const recent = articles.slice(0, 5);
---

<BaseLayout>
  <section class="home-hero">
    <p class="eyebrow">短い文芸誌のように、ニュースを読む</p>
    <h1 class="lede">今日の重大ニュースを、<br />エッセイと物語で読む。</h1>
    <p class="intro">毎日数分。事実を確かめた要約と、その日を少し考えるための読みものを届けます。</p>
  </section>

  {todayEssay && <section aria-labelledby="today-reading-heading">
    <div class="section-heading">
      <div><p class="eyebrow">{today ? formatDay(today) : 'TODAY'}</p><h2 id="today-reading-heading">今日の読み物</h2></div>
    </div>
    <article class="work-card work-card--essay">
      <p class="work-card__kind">{contentTypeLabel.essay}</p>
      <h3><a href={toUrl(`works/${todayEssay.slug}/`)}>{todayEssay.data.title}</a></h3>
      <p>{todayEssay.data.description}</p>
      <div class="hashtag-list">{todayEssay.data.hashtags.slice(0, 3).map((tag) => <a href={toUrl(`tags/${tag.slug}/`)}>#{tag.label}</a>)}</div>
      <a class="text-link" href={toUrl(`works/${todayEssay.slug}/`)}>エッセイを読む →</a>
    </article>
  </section>}

  {todayShortShort && <section aria-labelledby="today-short-short-heading">
    <div class="section-heading">
      <div><p class="eyebrow">TODAY'S SHORT SHORT</p><h2 id="today-short-short-heading">今日のショートショート</h2></div>
    </div>
    <article class="work-card work-card--short-short">
      <p class="work-card__kind">{contentTypeLabel['short-short']}</p>
      <h3><a href={toUrl(`works/${todayShortShort.slug}/`)}>{todayShortShort.data.title}</a></h3>
      <p>{todayShortShort.data.description}</p>
      <div class="hashtag-list">{todayShortShort.data.hashtags.slice(0, 3).map((tag) => <a href={toUrl(`tags/${tag.slug}/`)}>#{tag.label}</a>)}</div>
      <a class="text-link" href={toUrl(`works/${todayShortShort.slug}/`)}>ショートショートを読む →</a>
    </article>
  </section>}

  <section aria-labelledby="edition-heading">
    <div class="section-heading">
      <div><p class="eyebrow">LATEST EDITIONS</p><h2 id="edition-heading">最新の朝刊・夕刊</h2></div>
    </div>
    <div class="article-list">
      {latestMorning && <ArticleCard article={latestMorning} compact />}
      {latestEvening && <ArticleCard article={latestEvening} compact />}
    </div>
  </section>

  <div class="quick-links" aria-label="記事の探し方">
    <a class="quick-link" href={toUrl('calendar/')}><strong>カレンダーから読む</strong><span>日にちを選んで朝刊・夕刊へ</span></a>
    <a class="quick-link" href={toUrl('topics/')}><strong>ジャンルから読む</strong><span>気になるテーマの記事へ</span></a>
    <a class="quick-link quick-link--wide" href={toUrl('tags/')}><strong>タグから探す</strong><span>#原油 #中東 #日本銀行 など、気になる言葉から</span></a>
  </div>

  <Calendar articles={articles} />

  <section aria-labelledby="recent-heading">
    <div class="section-heading">
      <div><p class="eyebrow">バックナンバー</p><h2 id="recent-heading">最近の記事</h2></div>
      <a class="text-link" href={toUrl('archive/')}>すべて見る →</a>
    </div>
    <div class="article-list">
      {recent.map((article) => <ArticleCard article={article} compact />)}
    </div>
  </section>
</BaseLayout>
