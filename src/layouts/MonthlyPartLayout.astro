---
import type { CollectionEntry } from 'astro:content'; import BaseLayout from './BaseLayout.astro'; import MonthlyBadge from '../components/MonthlyBadge.astro'; import { monthlyLabel } from '../lib/monthly'; import { toUrl } from '../lib/paths';
interface Props { issue: CollectionEntry<'monthly'>; part: CollectionEntry<'monthlyParts'>; previous?: CollectionEntry<'monthlyParts'>; next?: CollectionEntry<'monthlyParts'> }
const { issue, part, previous, next } = Astro.props;
---
<BaseLayout title={`${part.data.title}｜${monthlyLabel(issue.data)}`} description={part.data.description} ogType="article" publishedTime={issue.data.date} section="月刊"><article class="monthly-page"><a class="back-link" href={toUrl(`monthly/${issue.slug}/`)}>← {monthlyLabel(issue.data)}の目次へ</a><header class="monthly-page__header"><MonthlyBadge /><p>{monthlyLabel(issue.data)}・第{part.data.order}回</p><h1>{part.data.title}</h1><p class="monthly-page__description">{part.data.description}・約{part.data.readingTime}分</p></header><div class="prose monthly-prose"><slot /></div><nav class="article-navigation" aria-label="月刊連載の移動">{previous ? <a href={toUrl(`monthly/${issue.slug}/${previous.slug}/`)}><small>← 前の読み物</small><span>{previous.data.title}</span></a> : <span />}{next ? <a class="article-navigation__next" href={toUrl(`monthly/${issue.slug}/${next.slug}/`)}><small>次の読み物 →</small><span>{next.data.title}</span></a> : <span />}</nav></article></BaseLayout>
