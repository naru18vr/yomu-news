---
import type { CollectionEntry } from 'astro:content'; import BaseLayout from './BaseLayout.astro'; import MonthlyBadge from '../components/MonthlyBadge.astro'; import { monthlyDisplayTitle, monthlyLabel } from '../lib/monthly'; import { toUrl } from '../lib/paths';
interface Props { issue: CollectionEntry<'monthly'>; part: CollectionEntry<'monthlyParts'>; previous?: CollectionEntry<'monthlyParts'>; next?: CollectionEntry<'monthlyParts'>; nextIssue?: CollectionEntry<'monthly'> }
const { issue, part, previous, next, nextIssue } = Astro.props;
---
<BaseLayout title={`${part.data.title}｜${monthlyLabel(issue.data)}`} description={part.data.description} ogType="article" publishedTime={issue.data.date} section="月刊"><article class="monthly-page"><a class="back-link" href={toUrl(`monthly/${issue.slug}/`)}>← {monthlyLabel(issue.data)}の目次へ</a><header class="monthly-page__header"><MonthlyBadge /><p>{monthlyLabel(issue.data)}・第{part.data.order}回</p><h1>{part.data.title}</h1><p class="monthly-page__description">{part.data.description}・約{part.data.readingTime}分</p></header><div class="prose monthly-prose"><slot /></div>{nextIssue && <section class="article-next-read" aria-labelledby="next-read-heading"><p class="eyebrow">次に読む</p><h2 id="next-read-heading">{monthlyLabel(nextIssue.data)}</h2><p class="article-next-read__title">{monthlyDisplayTitle(nextIssue.data)}</p><p>{nextIssue.data.description}</p><a class="button" href={toUrl(`monthly/${nextIssue.slug}/`)}>読む</a></section>}<nav class="article-secondary-nav" aria-label="月刊連載の移動">{previous && <a href={toUrl(`monthly/${issue.slug}/${previous.data.partSlug}/`)}>← 前の読み物</a>}{next && <a href={toUrl(`monthly/${issue.slug}/${next.data.partSlug}/`)}>次の読み物 →</a>}<a href={toUrl('monthly/')}>月刊一覧へ</a></nav></article></BaseLayout>
